# Copy to .env.local. Without these, the app runs in local demo mode
# (browser localStorage) and builds fine. With them, Supabase Auth +
# Postgres are available; see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
